{
  "expo": {
    "name": "simonetti-driver-app2",
    "slug": "simonetti-driver-app2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fahrer-icon-1024.png",
    "scheme": "simonettidriverapp2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fahrer-icon-1024.png",
        "backgroundColor": "#0f1a16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.eiscafe.simonettidriverapp2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fahrer-icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a10ec612-5b66-45cc-ba3a-bfe7f6039885"
      }
    }
  }
}
